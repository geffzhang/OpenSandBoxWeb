# OpenSandbox 平台地址与密钥（docker compose 注入后端配置）
# 默认使用 compose 内置的 opensandbox-server（同网络内可达）；
# 如需连接外部平台，改为其 URL，例如 https://sandbox.example.com
OPENSANDBOX_DOMAIN=http://opensandbox-server:8090
# 内置 server 未启用鉴权，留空即可；连接外部平台时填写
OPENSANDBOX_API_KEY=
# 后端调用 OpenSandbox SDK 的请求超时（秒）；冷拉执行器镜像较慢时可调大（如 120）
OPENSANDBOX_REQUEST_TIMEOUT_SECONDS=30
# ---- Local Keycloak (docker compose) ----
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Console OIDC. AUTH_AUTHORITY is the browser-visible realm URL; compose points
# Auth__MetadataAddress at http://keycloak:8080 for in-container discovery/JWKS.
# Production: use your own realm and set AUTH_REQUIRE_HTTPS_METADATA=true.
AUTH_AUTHORITY=http://localhost:8081/realms/opensandbox
AUTH_CLIENT_ID=opensandbox-web
AUTH_REQUIRE_HTTPS_METADATA=false
# Optional; compose defaults to the internal discovery URL.
# AUTH_METADATA_ADDRESS=http://keycloak:8080/realms/opensandbox/.well-known/openid-configuration

# VolumeManager 内置 PostgreSQL 密码（仅 compose 使用）
# compose 会把该值直接嵌入 Npgsql 连接串（ConnectionStrings__VolumeManager），
# 因此只能使用 URL/字母数字安全字符：字母、数字、-、_、.、~。
# 不要包含 ;、引号或空白：; 会被当作连接串分隔符，导致 web 容器在启动迁移时
# 解析失败并崩溃重启。
POSTGRES_PASSWORD=opensandbox
# 是否启用卷扫描。首次启动必须为 true（或对同一连接串运行迁移 Job /
# dotnet ef database update）以执行 EF 迁移建表；确认 schema 存在后，
# 没有 K8s API 的环境可设为 false：扫描停止，租户注册与只读路径仍可用。
# 全新数据库在 false 时没有表，卷接口返回 503 dependency_unavailable。
VOLUME_MANAGER_ENABLED=true
