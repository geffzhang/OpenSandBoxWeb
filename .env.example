# OpenSandbox 平台地址与密钥（docker compose 注入后端配置）
# 默认使用 compose 内置的 opensandbox-server（同网络内可达）；
# 如需连接外部平台，改为其 URL，例如 https://sandbox.example.com
OPENSANDBOX_DOMAIN=http://opensandbox-server:8090
# 内置 server 未启用鉴权，留空即可；连接外部平台时填写
OPENSANDBOX_API_KEY=
# 后端调用 OpenSandbox SDK 的请求超时（秒）；冷拉执行器镜像较慢时可调大（如 120）
OPENSANDBOX_REQUEST_TIMEOUT_SECONDS=30
# 控制台 Keycloak 登录：realm 地址与公共客户端 ID（必填）
AUTH_AUTHORITY=https://dev-passport.ai4c.cn/realms/ai4cbrain
AUTH_CLIENT_ID=opensandbox-web
# Keycloak 使用 HTTP（本地/内网）时设为 false；HTTPS 保持 true
AUTH_REQUIRE_HTTPS_METADATA=true
